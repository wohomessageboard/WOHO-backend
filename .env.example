# Copia este archivo a .env y completa los valores. NUNCA subas .env a GitHub.

# --- Base de datos (usa DATABASE_URL en producción, o las DB_* en local) ---
DATABASE_URL=
DB_USER=
DB_HOST=localhost
DB_NAME=Driftler
DB_PASSWORD=
DB_PORT=5432

# --- Seguridad ---
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# --- Direcciones ---
PORT=4310
# Dirección del sitio (frontend). Se usa para CORS y para los enlaces de los correos y las tarjetas.
# Puedes poner varias separadas por coma; la primera es la principal:
#   FRONTEND_URL=https://woho.tudominio.com,https://woho.vercel.app
FRONTEND_URL=http://localhost:4311
# Solo si el servidor está detrás de un proxy que cambia el host (opcional):
# En Vercel conviene definirla: PUBLIC_API_URL=https://tu-backend.vercel.app/api
# PUBLIC_API_URL=https://api.tudominio.com/api

# --- Imágenes (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Correo (Resend) — opcional hasta que tengas la cuenta ---
# Sin RESEND_API_KEY los correos no se envían (en desarrollo se imprimen en la consola).
RESEND_API_KEY=
# Remitente verificado en Resend. Para probar sin dominio: Driftler <onboarding@resend.dev>
MAIL_FROM=Driftler <onboarding@resend.dev>
# A este correo llega el resumen diario (1 correo al día como máximo, solo si hay novedades).
ADMIN_NOTIFY_EMAIL=
# Clave para que el programador diario pueda llamar a /api/cron/daily-digest
CRON_SECRET=
